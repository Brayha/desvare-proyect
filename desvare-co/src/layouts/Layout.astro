---
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
  ga4Id?: string;
}

const {
  title = 'Grúa en Bogotá — Cotiza en minutos | Desvare',
  description = 'Servicio de grúa en Bogotá y Cundinamarca. Cotizaciones en tiempo real de conductores cercanos. Compara precios, elige y sigue tu grúa en el mapa.',
  ga4Id = import.meta.env.PUBLIC_GA4_ID,
} = Astro.props;

const canonical = Astro.site?.href ?? 'https://www.desvare.co/';
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0055ff" />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="grúa Bogotá, servicio de grúa Cundinamarca, grúa urgente, cotizar grúa, remolque vehículo Bogotá, auxilio vial"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Desvare" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${canonical}og-image.jpg`} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${canonical}og-image.jpg`} />

    <link rel="icon" href="/icons/icon-192x192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />

    <link rel="preload" href="/fonts/Gilroy-Bold.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/Gilroy-Regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/maps/map-desktop.png" as="image" media="(min-width: 1025px)" />
    <link rel="preload" href="/maps/map-tablet.png" as="image" media="(max-width: 1024px) and (min-width: 641px)" />
    <link rel="preload" href="/maps/map-mobile.png" as="image" media="(max-width: 640px)" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'Desvare',
      description,
      url: canonical,
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Cundinamarca',
        containsPlace: { '@type': 'City', name: 'Bogotá' },
      },
      serviceType: 'Servicio de grúa',
      priceRange: '$$',
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.8',
        reviewCount: '120',
      },
    })} />

    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />

    <script is:inline>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Navbar scroll state
      const nav = document.querySelector('.nav');
      if (nav) {
        const onScroll = () => nav.classList.toggle('nav--solid', window.scrollY > 48);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // Track CTA clicks (GA4)
      document.querySelectorAll('[data-track="cotizar"]').forEach((el) => {
        el.addEventListener('click', () => {
          if (typeof gtag === 'function') {
            gtag('event', 'click_cotizar', {
              event_category: 'engagement',
              event_label: el.getAttribute('data-track-label') || 'cta',
            });
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  body {
    min-height: 100vh;
  }
</style>
