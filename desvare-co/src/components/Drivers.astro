---
import { driverBenefits, DRIVER_REGISTER_URL } from '../data/site';
---

<section id="conductores" class="drivers reveal" aria-labelledby="drivers-title">
  <div class="container">
    <div class="drivers__inner">
      <div class="drivers__content">
        <p class="section-label section-label--light">Para conductores</p>
        <h2 id="drivers-title" class="section-title section-title--light">
          ¿Tienes una grúa?<br />Gana más con Desvare
        </h2>
        <p class="drivers__desc">
          Aumenta tus ingresos llegando a más clientes en Bogotá. Nuestra app es completamente gratuita y los pagos son directos.
        </p>

        <ul class="drivers__benefits" role="list">
          {driverBenefits.map((b) => (
            <li class="drivers__benefit" role="listitem">
              <span class="drivers__check" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="currentColor"/>
                </svg>
              </span>
              {b}
            </li>
          ))}
        </ul>

        <a href="https://play.google.com/store/apps/details?id=com.desvare.driver" class="btn btn--white btn--large drivers__cta" target="_blank" rel="noopener noreferrer">
          Descargar la app
        </a>
      </div>

      <div class="drivers__visual" aria-hidden="true">
        <div class="drivers__mockup">
          <div class="drivers__mockup-header">
            <span></span><span></span><span></span>
          </div>
          <div class="drivers__mockup-body">
            <div class="drivers__mockup-stat">
              <p class="drivers__mockup-label">Esta semana</p>
              <p class="drivers__mockup-value">$485.000</p>
            </div>
            <div class="drivers__mockup-row">
              <span>Servicios realizados</span>
              <strong>7</strong>
            </div>
            <div class="drivers__mockup-row">
              <span>Calificación</span>
              <strong>⭐ 4.9</strong>
            </div>
            <div class="drivers__mockup-row">
              <span>Estado</span>
              <span class="drivers__badge">Activo</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .drivers {
    padding: 96px 0;
    background: var(--bg-dark);
    color: #fff;
  }

  .drivers__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .drivers__desc {
    margin-top: 16px;
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.65;
    max-width: 480px;
  }

  .drivers__benefits {
    list-style: none;
    margin: 32px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .drivers__benefit {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .drivers__check {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 85, 255, 0.2);
    color: #6ea8ff;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .drivers__mockup {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .drivers__mockup-header {
    display: flex;
    gap: 6px;
    padding: 14px 16px;
    background: rgba(0, 0, 0, 0.2);
  }

  .drivers__mockup-header span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .drivers__mockup-body {
    padding: 28px;
  }

  .drivers__mockup-stat {
    margin-bottom: 24px;
  }

  .drivers__mockup-label {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .drivers__mockup-value {
    font-size: 2rem;
    font-weight: 900;
    color: #fff;
  }

  .drivers__mockup-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .drivers__mockup-row strong {
    color: #fff;
  }

  .drivers__badge {
    background: rgba(45, 211, 111, 0.2);
    color: #2dd36f;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .drivers {
      padding: 64px 0;
    }

    .drivers__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .drivers__visual {
      order: -1;
      max-width: 360px;
    }
  }
</style>
