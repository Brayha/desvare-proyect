---
import { cotizarUrl } from '../data/site';
---

<section class="cta-final reveal" aria-labelledby="cta-title">
  <div class="container container--narrow cta-final__inner">
    <h2 id="cta-title" class="cta-final__title">¿Necesitas una grúa ahora?</h2>
    <p class="cta-final__desc">
      En minutos tendrás cotizaciones reales de conductores cerca de ti en Bogotá.
    </p>
    <a
      href={cotizarUrl('cta-final')}
      class="btn btn--primary btn--large"
      data-track="cotizar"
      data-track-label="cta-final"
    >
      Solicitar grúa ahora
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" fill="currentColor"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .cta-final {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--primary) 0%, #0044cc 100%);
    text-align: center;
  }

  .cta-final__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 900;
    color: #fff;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .cta-final__desc {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 32px;
  }

  .cta-final .btn--primary {
    background: #fff;
    color: var(--primary);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  }

  .cta-final .btn--primary:hover {
    background: var(--primary-light);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
  }
</style>
