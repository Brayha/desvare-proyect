---
import MapIllustration from './MapIllustration.astro';
import { mapQuotes, cotizarUrl, CITY, REGION } from '../data/site';
---

<section class="hero" aria-label="Solicita cotización de grúa">
  <!-- Mapa a pantalla completa (detrás de todo) -->
  <div class="hero__map-layer" aria-hidden="true">
    <MapIllustration />
  </div>

  <!-- Degradado: textos legibles arriba, mapa visible al centro, funde abajo -->
  <div class="hero__gradient" aria-hidden="true"></div>

  <!-- Textos + CTA sobre el degradado -->
  <div class="hero__content container">
    <p class="hero__badge">
      <span class="hero__badge-dot" aria-hidden="true"></span>
      Cotiza tu servicio de grúa
    </p>

    <h1 class="hero__title">
      Pide tu grúa<br />
      <span class="hero__title-accent">en minutos</span>
    </h1>

    <p class="hero__desc">
      Cotiza en tiempo real, compara precios de conductores cercanos y recibe ayuda al instante.
    </p>

    <div class="hero__actions">
      <a
        href={cotizarUrl('hero')}
        class="btn btn--primary btn--large"
        data-track="cotizar"
        data-track-label="hero"
      >
        Cotizar servicio de grúa
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" fill="currentColor"/>
        </svg>
      </a>
    </div>

    <p class="hero__disclaimer">Gratis · Sin registro previo · Cotizaciones en tiempo real</p>
  </div>

  <!-- Pin del usuario -->
  <div class="hero__user-pin" aria-hidden="true">
    <span class="hero__user-pulse"></span>
    <span class="hero__user-dot"></span>
  </div>

  <!-- Globos de precio — solo valor, aparecen y desaparecen -->
  <div class="hero__prices" aria-hidden="true">
    {mapQuotes.map((q) => (
      <div class={`price-bubble price-bubble--${q.id}`} style={`animation-delay: ${q.delay};`}>
        <span class="price-bubble__value">{q.price}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100vh, 880px);
    padding-top: calc(var(--nav-h) + 28px);
    padding-bottom: 80px;
    overflow: hidden;
    background: #fff;
  }

  .hero__map-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
   margin-top:105px;
    /* Suaviza el mapa para que el degradado y el texto respiren */
    filter: saturate(0.92) contrast(0.96);
  }

  /* Degradado sobre el mapa — el copy vive encima de esto */
  .hero__gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.98) 0%,
      rgba(255, 255, 255, 0.94) 12%,
      rgba(255, 255, 255, 0.78) 24%,
      rgba(255, 255, 255, 0.45) 38%,
      rgba(255, 255, 255, 0.18) 52%,
      rgba(255, 255, 255, 0.25) 68%,
      rgba(255, 255, 255, 0.72) 84%,
      rgba(255, 255, 255, 0.98) 100%
    );
  }

  /* Contenido centrado sobre degradado */
  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 680px;
    padding-bottom: clamp(180px, 28vw, 320px);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--primary);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(6px);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    margin-bottom: 18px;
    border: 1px solid rgba(0, 85, 255, 0.1);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse-dot 2s ease infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .hero__title {
    font-size: clamp(2.125rem, 5.5vw, 3.375rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 14px;
  }

  .hero__title-accent {
    color: var(--primary);
  }

  .hero__desc {
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 540px;
    margin: 0 auto 26px;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    margin-bottom: 10px;
  }

  .hero__disclaimer {
    font-size: 0.8125rem;
    color: var(--text-light);
  }

  /* Pin ubicación del cliente */
  .hero__user-pin {
    position: absolute;
    z-index: 3;
    top: 58%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hero__user-dot {
    display: block;
    width: 14px;
    height: 14px;
    background: var(--primary);
    border: 3px solid #fff;
    border-radius: 50%;
    box-shadow: 0 2px 14px rgba(0, 85, 255, 0.45);
    position: relative;
    z-index: 1;
  }

  .hero__user-pulse {
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    background: rgba(0, 85, 255, 0.22);
    animation: pinPulse 2.2s ease-out infinite;
  }

  /* Globos de precio */
  .hero__prices {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .price-bubble {
    position: absolute;
    animation: priceBubble 12s ease-in-out infinite;
    opacity: 0;
    transform: translate(-50%, 8px) scale(0.92);
  }

  .price-bubble__value {
    display: block;
    background: #fff;
    color: var(--primary);
    font-size: 0.9375rem;
    font-weight: 800;
    padding: 10px 16px;
    border-radius: var(--radius-full);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 85, 255, 0.08);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  @keyframes priceBubble {
    0%, 100% {
      opacity: 0;
      transform: translate(-50%, 10px) scale(0.9);
    }
    6%, 18% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    22% {
      opacity: 0;
      transform: translate(-50%, -6px) scale(0.96);
    }
  }

  /* Posiciones desktop */
  .price-bubble--1 { top: 52%; left: 22%; }
  .price-bubble--2 { top: 44%; left: 72%; }
  .price-bubble--3 { top: 62%; left: 58%; }
  .price-bubble--4 { top: 48%; left: 42%; }
  .price-bubble--5 { top: 68%; left: 32%; }
  .price-bubble--6 { top: 56%; left: 82%; }

  /* Tablet */
  @media (max-width: 768px) {
    .hero {
      min-height: min(100svh, 820px);
      padding-bottom: 60px;
    }

    .hero__content {
      padding-bottom: clamp(200px, 42vw, 280px);
    }

    .hero__user-pin {
      top: 62%;
    }

    .price-bubble--1 { top: 54%; left: 16%; }
    .price-bubble--2 { top: 46%; left: 78%; }
    .price-bubble--3 { top: 66%; left: 52%; }
    .price-bubble--4 { top: 50%; left: 38%; }
    .price-bubble--5 { top: 72%; left: 24%; }
    .price-bubble--6 { top: 58%; left: 86%; }

    .price-bubble__value {
      font-size: 0.875rem;
      padding: 8px 14px;
    }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .hero {
      padding-top: calc(var(--nav-h) + 16px);
    }

    .hero__gradient {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.9) 40%,
        rgba(255, 255, 255, 0.55) 50%,
        rgba(255, 255, 255, 0.2) 70%,
        rgba(255, 255, 255, 0.3) 80%,
        rgba(255, 255, 255, 0.85) 100%,
        #fff 100%
      );
    }

    .hero__content {
      padding-bottom: 220px;
    }

    .price-bubble--1 { top: 56%; left: 12%; }
    .price-bubble--2 { top: 48%; left: 82%; }
    .price-bubble--3 { top: 68%; left: 48%; }
    .price-bubble--4 { top: 52%; left: 30%; }
    .price-bubble--5 { top: 74%; left: 18%; }
    .price-bubble--6 { top: 60%; left: 88%; }
  }
</style>
