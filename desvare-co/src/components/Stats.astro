---
import { stats } from '../data/site';
---

<section class="stats reveal" aria-label="Estadísticas de Desvare">
  <div class="container">
    <div class="stats__grid">
      {stats.map((stat, i) => (
        <div class={`stats__item ${i > 0 ? 'stats__item--divider' : ''}`}>
          <p class="stats__number">{stat.value}</p>
          <p class="stats__label">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    padding: 48px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: center;
  }

  .stats__item {
    padding: 16px;
  }

  .stats__item--divider {
    border-left: 1px solid var(--border);
  }

  .stats__number {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 900;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .stats__label {
    margin-top: 4px;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .stats__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .stats__item--divider {
      border-left: none;
      border-top: 1px solid var(--border);
    }
  }
</style>
