---
/**
 * Mapa de fondo del hero — capturas Mapbox en 3 tamaños.
 * mobile: 601×1024 | tablet: 1024×992 | desktop: 1024×579
 */
---

<picture class="map-photo">
  <source media="(max-width: 640px)" srcset="/maps/map-mobile.png" />
  <source media="(max-width: 1024px)" srcset="/maps/map-tablet.png" />
  <img
    src="/maps/map-desktop.png"
    alt=""
    class="map-photo__img"
    width="1024"
    height="579"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</picture>

<style>
  .map-photo {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .map-photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  @media (max-width: 1024px) {
    .map-photo__img {
      object-position: center 48%;
    }
  }

  @media (max-width: 640px) {
    .map-photo__img {
      object-position: center 38%;
    }
  }
</style>
