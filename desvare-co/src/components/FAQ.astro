---
import { faqs } from '../data/site';
---

<section id="faq" class="faq reveal" aria-labelledby="faq-title">
  <div class="container container--narrow">
    <div class="section-header">
      <p class="section-label">Resolvemos tus dudas</p>
      <h2 id="faq-title" class="section-title">Preguntas frecuentes</h2>
    </div>

    <div class="faq__list">
      {faqs.map((item, i) => (
        <details class="faq__item">
          <summary class="faq__question">
            {item.q}
            <span class="faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq__answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 96px 0;
    background: var(--bg-soft);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq__item {
    background: var(--bg);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: box-shadow var(--transition);
  }

  .faq__item[open] {
    box-shadow: var(--shadow-sm);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    color: var(--text);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--primary);
    transition: transform var(--transition);
    flex-shrink: 0;
  }

  .faq__answer {
    padding: 0 24px 20px;
  }

  .faq__answer p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .faq {
      padding: 64px 0;
    }
  }
</style>
